{
  "name": "@local/datasource",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "数据分析的数据源插件：加密凭据、结构剖析、只读 SQL。不保存原料或页面。",
  "exports": {
    ".": "./src/plugin.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "src/**/*.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dependencies": {
    "@local/contracts": "file:../contracts",
    "mysql2": "^3.24.6",
    "pg": "^8.23.1",
    "zod": "^4.4.3"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-locale", "@deepseek-ai/dsh-client-ui-settings", "@deepseek-ai/dsh-api-remotes", "@deepseek-ai/dsh-client-ui-session"]
    }
  }
}
